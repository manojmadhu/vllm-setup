# =============================================================================
# vLLM enterprise stack — environment file
# Copy to .env (scripts/02-init-secrets.sh does this and fills in secrets).
# Keep .env at chmod 600. Never commit it.
# =============================================================================

# ---- Images (pinned; review release notes before bumping) -------------------
# vLLM v0.31.0 default image is built on CUDA 13.0 (needs NVIDIA driver >= 580).
# If your driver is older, or your GPU is a V100 (SM70), use the -cu129 tag.
VLLM_IMAGE=vllm/vllm-openai:v0.31.0
# VLLM_IMAGE=vllm/vllm-openai:v0.31.0-cu129
NGINX_IMAGE=nginx:1.28-alpine
PROMETHEUS_IMAGE=prom/prometheus:v3.5.0
ALERTMANAGER_IMAGE=prom/alertmanager:v0.28.1
GRAFANA_IMAGE=grafana/grafana:12.0.2
NODE_EXPORTER_IMAGE=prom/node-exporter:v1.9.1
DCGM_EXPORTER_IMAGE=nvcr.io/nvidia/k8s/dcgm-exporter:4.6.0-4.8.4-distroless
NGINX_EXPORTER_IMAGE=nginx/nginx-prometheus-exporter:1.4.2

# ---- Model -------------------------------------------------------------------
# 14B, 4-bit AWQ: ~10 GB of weights, leaves ~3 GB KV cache on a 16 GB GPU.
MODEL_ID=Qwen/Qwen2.5-14B-Instruct-AWQ
# Stable name your apps call, independent of which checkpoint is loaded.
SERVED_MODEL_NAME=enterprise-llm
# Only needed for gated/private Hugging Face repos.
HF_TOKEN=

# ---- vLLM engine tuning for a 16 GB Tesla T4 (SM75) -------------------------
QUANTIZATION=awq
# T4 has no bfloat16 support -> float16 ("half")
DTYPE=half
MAX_MODEL_LEN=8192
MAX_NUM_SEQS=8
MAX_NUM_BATCHED_TOKENS=2048
GPU_MEMORY_UTILIZATION=0.90
# Back-pressure: reject (instead of queueing forever) beyond this many waiting requests
MAX_NUM_QUEUED_REQS=32
# Tool/function calling parser for Qwen2.5 (agents)
TOOL_CALL_PARSER=hermes

# ---- Secrets (generated by scripts/02-init-secrets.sh) -----------------------
# Internal key between gateway and vLLM. Client apps NEVER see this key;
# they get their own per-application keys in nginx/api-keys/keys.map.
VLLM_API_KEY=
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# ---- Gateway -----------------------------------------------------------------
# Bind the gateway to the VM's PRIVATE IP (see: ip -4 addr show eth0).
# Do not use 0.0.0.0 on a VM that has a public IP.
GATEWAY_BIND_IP=10.0.0.4
GATEWAY_SERVER_NAME=llm.internal.example.com
# Per client API key (requests per minute) and allowed burst above that
RATE_LIMIT_PER_CLIENT=60r/m
RATE_LIMIT_BURST=20
# Concurrent in-flight requests per client key
MAX_CONCURRENT_PER_CLIENT=4
MAX_BODY_SIZE=8m
# Seconds the gateway waits for a (streamed) response
UPSTREAM_TIMEOUT=600s

# ---- Monitoring --------------------------------------------------------------
PROMETHEUS_RETENTION=30d
